{
  "name": "@deepseek-ai/dsh-cost-adaptive",
  "version": "0.1.0-rc.5",
  "description": "Self-adapting context-cost guard: observes tool-result and turn usage, aggregates waste statistics across sessions, and injects learned cost guidance into the system prompt",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src/**/*.ts",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run test && pnpm run typecheck && pnpm run build"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "cordis",
    "llm",
    "cost",
    "token",
    "context",
    "self-adaptive"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-command-feedback": ">=0.1.0-rc.8 <0.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": ">=0.1.0-rc.8 <0.2",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.8 <0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.2",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.2",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.8 <0.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.8 <0.2",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": ">=0.1.0-rc.8 <0.2",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.8 <0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-command-feedback": "0.1.0-rc.8",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-cost-adaptive": "link:."
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
